[Unit]
Description=DAD (Dumbass Daemon) - Error Learning System
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dad-daemon
Restart=on-failure
RestartSec=5s
User=%U
Environment="RUST_LOG=dad_core=info"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%U/.local/share/dad

[Install]
WantedBy=default.target
